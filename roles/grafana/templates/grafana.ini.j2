; Grafana Configuration v{{ grafana_version }}
; Managed by Ansible — do not edit manually

[paths]
data         = {{ grafana_data_dir }}
logs         = {{ grafana_logs_dir }}
plugins      = {{ grafana_plugins_dir }}
provisioning = /etc/grafana/provisioning

[server]
protocol            = http
http_addr           = 0.0.0.0
http_port           = {{ grafana_port }}
domain              = {{ grafana_domain }}
root_url            = %(protocol)s://%(domain)s:%(http_port)s/
serve_from_sub_path = false

[database]
type = sqlite3
path = {{ grafana_data_dir }}/grafana.db

[security]
admin_user     = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}
secret_key     = {{ lookup('password', '/dev/null chars=ascii_letters,digits length=32') }}
disable_gravatar = true
cookie_secure    = false
cookie_samesite  = lax

[users]
allow_sign_up        = {{ grafana_allow_sign_up }}
auto_assign_org      = true
auto_assign_org_id   = 1
auto_assign_org_role = Viewer
default_theme        = dark

[auth.anonymous]
enabled = false

[unified_alerting]
enabled = true

[alerting]
enabled = false

[log]
mode  = console file
level = info

[log.file]
log_rotate     = true
max_lines      = 1000000
max_size_shift = 28
daily_rotate   = true
max_days       = 7

[metrics]
enabled          = true
interval_seconds = 10

[plugins]
enable_alpha = false
allow_loading_unsigned_plugins = alexanderzobnin-zabbix-datasource,alexanderzobnin-zabbix-app

[smtp]
enabled = false
; host     = smtp.example.com:587
; user     = grafana@example.com
; password = changeme
; from_address = grafana@example.com
; from_name    = Grafana
