---
# Prometheus Configuration
# Managed by Ansible — do not edit manually
# Scrape targets are built automatically from inventory/hosts.yml

global:
  scrape_interval:     15s
  evaluation_interval: 15s
  scrape_timeout:      10s
  external_labels:
    monitor: 'monitoring-stack'
    environment: 'production'

rule_files:
  - "{{ prometheus_config_dir }}/rules/*.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:{{ alertmanager_port }}"]

scrape_configs:

  # Prometheus scrapes itself
  - job_name: "prometheus_self"
    static_configs:
      - targets: ["localhost:{{ prometheus_port }}"]

  # Alertmanager
  - job_name: "alertmanager"
    static_configs:
      - targets: ["localhost:{{ alertmanager_port }}"]

  # Node Exporter — auto-built from ALL hosts in the monitored group
  - job_name: "node_exporter"
    static_configs:
      - targets:
{% for host in groups['monitored'] %}
          - "{{ hostvars[host]['ansible_host'] }}:{{ node_exporter_port }}"
{% endfor %}
        labels:
          env: "production"

  # Zabbix Agent — monitoring VMs only
  - job_name: "zabbix_agent"
    static_configs:
      - targets:
{% for host in groups['zabbix'] %}
          - "{{ hostvars[host]['ansible_host'] }}:{{ zabbix_agent_port }}"
{% endfor %}
