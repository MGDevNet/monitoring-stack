# Zabbix Server Configuration
# Managed by Ansible — do not edit manually
# Version: {{ zabbix_version }} | Database: MySQL

ListenPort={{ zabbix_server_port }}
LogFile={{ zabbix_log_dir }}/zabbix_server.log
LogFileSize=10
PidFile={{ zabbix_pid_dir }}/zabbix_server.pid
SocketDir={{ zabbix_pid_dir }}

DBHost={{ zabbix_db_host }}
DBPort={{ zabbix_db_port }}
DBName={{ zabbix_db_name }}
DBUser={{ zabbix_db_user }}
DBPassword={{ zabbix_db_password }}
DBSocket=/var/run/mysqld/mysqld.sock

StartPollers=10
StartPollersUnreachable=2
StartPingers=5
StartTrappers=5
StartHTTPPollers=5
StartDiscoverers=3
StartPreprocessors=4
StartTimers=2
StartEscalators=2
StartAlerters=3

CacheSize={{ zabbix_cache_size }}
HistoryCacheSize={{ zabbix_history_cache_size }}
HistoryIndexCacheSize={{ zabbix_history_index_cache_size }}
TrendCacheSize={{ zabbix_trend_cache_size }}
ValueCacheSize={{ zabbix_value_cache_size }}

Timeout=30
TrapperTimeout=300
UnreachablePeriod=45
UnavailableDelay=60
UnreachableDelay=15

AlertScriptsPath=/usr/lib/zabbix/alertscripts
ExternalScripts=/usr/lib/zabbix/externalscripts
DebugLevel=3
